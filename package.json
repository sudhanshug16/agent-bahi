{
  "name": "@sudhanshug/agent-bahi",
  "version": "1.0.1",
  "description": "Agent-first India accounting, bookkeeping, tax, payroll, reporting, CLI, and MCP system backed by SQLite.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudhanshug16/agent-bahi.git"
  },
  "homepage": "https://github.com/sudhanshug16/agent-bahi",
  "bugs": {
    "url": "https://github.com/sudhanshug16/agent-bahi/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "files": [
    "LICENSE",
    "README.md",
    "docs",
    "drizzle",
    "runtime-versions.json",
    "skills",
    "src",
    "scripts"
  ],
  "bin": {
    "agent-bahi": "src/cli.ts",
    "agent-bahi-mcp": "src/mcp.ts"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate:skills": "bun scripts/validate-skills.ts",
    "test:release": "bun test tests/release-packaging.test.ts",
    "release:check": "bun run typecheck && bun run validate:skills && bun test",
    "prepublishOnly": "bun run release:check",
    "test:gate0": "bun test tests/gate0/gate0.test.ts",
    "test:commands": "bun test tests/application/bookset-command.test.ts",
    "test": "bun test",
    "build": "bun build src/cli.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile dist/agent-bahi",
    "build:macos-arm64": "bun build src/cli.ts --compile --target=bun-darwin-arm64 --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile dist/agent-bahi-darwin-arm64",
    "release:manifest": "bun scripts/release-manifest.ts",
    "build:release": "bun run build && bun run build:macos-arm64 && bun run release:manifest",
    "build:gate0": "bun build spikes/gate0/cli-smoke.ts --compile --outfile .gate0-build/agent-bahi-gate0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "drizzle-kit": "0.31.10",
    "typescript": "5.8.3"
  }
}
